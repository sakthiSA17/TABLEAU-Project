{"ts":"2026-10-13T12:40:05.950485","pid":14500,"tid":"33fc|mux t10","sev":"info","req":"6","sess":"PlwOKhnLSsqdkyDrXXONEg","ctx":{"workload":{"name":"tableau-interactive"},"tenant-id":"-","user-agent":"{\"app\": \"Tableau Public\", \"edition\": \"public\", \"version\": \"20262.26.0912.1023\"}","client":{"req":"RR-0wh74pa092oa1t18fui870l053rw","sess":"RS-0xfyai402z1dem14ywxcb10ldw5k","site":"-","user":"-","host":"SAKTHI-17"}},"k":"query-begin","v":{"spooling":false,"query-settings-active":false,"query-hash":"c3b2.459d0bfad00c.b7b752","query":"SELECT a.attname, a.atttypid, a.attnotnull, a.attnum, a.atttypmod, s.n_distinct,\n       CASE WHEN a.attcollation <> t.typcollation THEN c.collname ELSE NULL END AS attcollation,\n       d.description\n  FROM pg_catalog.pg_attribute a\n  JOIN pg_catalog.pg_class cl\n    ON a.attrelid = cl.oid\n  LEFT JOIN pg_catalog.pg_description d\n    ON cl.oid = d.objoid AND a.attnum = d.objsubid\n  LEFT JOIN pg_catalog.pg_collation c\n    ON c.oid = a.attcollation\n  LEFT JOIN pg_catalog.pg_type t\n    ON t.oid = a.atttypid\n  LEFT JOIN pg_catalog.pg_stats s\n    ON s.attname = a.attname AND s.tablename = 'Extract' AND s.schemaname = 'Extract'\n  WHERE a.attnum > 0\n   AND NOT a.attisdropped\n   AND cl.relname = 'Extract'\n   AND cl.relnamespace = 10004"}}
