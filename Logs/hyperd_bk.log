{"ts":"2026-10-14T11:20:09.378735","pid":24664,"tid":"c1c|mux t10","sev":"info","req":"8","sess":"z7Hkd6vyS5i7JcIIR-yF_A","ctx":{"workload":{"name":"tableau-interactive"},"tenant-id":"-","user-agent":"{\"app\": \"Tableau Public\", \"edition\": \"public\", \"version\": \"20262.26.0912.1023\"}","client":{"req":"RR-16yb0wn1nimpqy1c2m7dk1c8frdl","sess":"RS-0jlm95o1e79kq517trs9o0mdltz4","site":"-","user":"-","host":"SAKTHI-17"}},"k":"query-begin","v":{"spooling":false,"query-settings-active":false,"query-hash":"3a54.7d599d119401.b84a3e","query":"SELECT c.contype, c.conname, a.attname, a.attnotnull, tns.relname, unnest_conkey, conkey_string, tns.nspname as ref_ns\n  FROM pg_catalog.pg_class cl\n  JOIN ( SELECT c.contype, unnest(c.conkey) AS unnest_conkey,\n                c.conname, c.confrelid, array_to_string(c.conkey, ',', '*') as conkey_string,\n                c.conrelid\n          FROM pg_catalog.pg_constraint c) c\n   ON c.conrelid = cl.oid\n  JOIN pg_catalog.pg_attribute a\n   ON  c.unnest_conkey = a.attnum\n   AND a.attrelid      = cl.oid\n  LEFT JOIN (\n    SELECT t.oid, t.relname, ns.nspname\n    FROM pg_catalog.pg_class t\n    JOIN pg_catalog.pg_namespace ns\n      ON ns.oid = t.relnamespace\n    WHERE t.relkind IN('r','v','f')\n     AND ns.nspname not like 'pg_catalog') tns\n  ON c.confrelid = tns.oid\n WHERE NOT a.attisdropped\n   AND cl.relname = 'Extract'\n   AND cl.relnamespace = 10004"}}
