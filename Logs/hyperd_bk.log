d\",\n  \"AirBnB_NYC\".\"Number Of Reviews\" AS \"Number Of Reviews\",\n  \"AirBnB_NYC\".\"Number of Records\" AS \"Number of Records\",\n  \"AirBnB_NYC\".\"Price\" AS \"Price\",\n  \"AirBnB_NYC\".\"Property Type\" AS \"Property Type\",\n  \"AirBnB_NYC\".\"Review Scores Rating (bin)\" AS \"Review Scores Rating (bin)\",\n  \"AirBnB_NYC\".\"Review Scores Rating\" AS \"Review Scores Rating\",\n  (CASE \"AirBnB_NYC\".\"Room Type\" WHEN 'Private room' THEN 'Budgut Stay' WHEN 'Entire home/apt' THEN 'Premium Stay' WHEN 'Shared room' THEN 'Shared Accomodation' ELSE \"AirBnB_NYC\".\"Room Type\" END) AS \"Room Category\",\n  \"AirBnB_NYC\".\"Room Type\" AS \"Room Type\",\n  \"AirBnB_NYC\".\"Zipcode\" AS \"Zipcode\",\n  \"AirBnB_NYC\".\"ctid\" AS \"$__alias__0\"\nFROM \"TableauTemp\".\"AirBnB_NYC$\" \"AirBnB_NYC\"\nORDER BY \"$__alias__0\" ASC NULLS FIRST\nLIMIT 100\n/* { \"tableau-query-origins\": { \"lqctx-root-activity-id\": \"HM1WZg71EAjJ+itiI5pvzv\", \"query-category\": \"Data\" } } */"}}
